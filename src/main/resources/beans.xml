<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Address Bean -->
    <bean id="addressBean" class="com.learning.spring.Address">
        <property name="city" value="Pune"/>
        <property name="pinCode" value="411015"/>
    </bean>

    <!-- Student Bean -->
    <bean id="studentBean" class="com.learning.spring.Student" >
        <property name="name" value="Aarya Gupta" />
        <property name="rollNo" value="2"/>
        <property name="address" ref="addressBean"/>
        <property name="classNo" value="5"/>
    </bean>

</beans>
